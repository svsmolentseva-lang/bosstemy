# Токен бота. Выдаётся в кабинете разработчика MAX после модерации.
BOT_TOKEN=
# База данных: файл SQLite. Для продакшена меняется на Postgres — см. app/db.py
DB_PATH=boss.db
# Правила игры
DAMAGE_PER_HIT=20
MIN_ANSWER_SECONDS=3
DAILY_HIT_CAP=12
DEFAULT_RAID_HP=300
WEBAPP_URL=http://localhost:8080
ALLOW_DEV_AUTH=0
WEBHOOK_PATH=/hook/придумайте-длинную-строку
